# RPC endpoints for chains
RPC_MAINNET=https://mainnet.infura.io/v3/dbefd23a29a84fd7ac661cb9c282dc0c
RPC_ARBITRUM=https://arbitrum-mainnet.infura.io/v3/dbefd23a29a84fd7ac661cb9c282dc0c
RPC_BSC=https://bsc.trustkeys.exchange/

# Fallback single RPC (used by older code paths)
ETH_RPC_URL=${RPC_MAINNET}

# Multicall batching and concurrency
MULTICALL_BATCH_SIZE=100
GRAPHQL_MAX_CONCURRENCY=4

# Optional local token list file (Uniswap tokenlist or simple map)
TOKEN_LIST_FILE=./tokenlist.json
